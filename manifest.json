{
  "manifest_version": 3,
  "name": "小红书采集工作台",
  "version": "1.0.0",
  "description": "对标阿乐采集工作台的小红书采集插件：单篇/关键词/联想词/矩阵/评论/收藏六入口采集，飞书多维表格实时同步，本地素材缓存与本地转写（OCR）。",
  "permissions": [
    "sidePanel",
    "scripting",
    "activeTab",
    "storage",
    "identity",
    "webRequest",
    "cookies",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.xiaohongshu.com/*",
    "https://edith.xiaohongshu.com/*",
    "https://open.feishu.cn/*",
    "https://base-api.feishu.cn/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self' https://cdn.jsdelivr.net https://unpkg.com; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_title": "打开小红书采集工作台",
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.xiaohongshu.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css", "logo.png", "logogif.gif", "offscreen.html", "vendor/*", "ocr-worker/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
